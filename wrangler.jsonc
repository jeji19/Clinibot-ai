{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clinibot-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-11-08",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "RESEND_TO_EMAIL": "albizrahemran@gmail.com"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
